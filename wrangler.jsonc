/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eleen-ai-beta-v1",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "ELEEN_MEMORY",
			"id": "66feaec842224318820adb53c0c99492"
		}
	],
	"r2_buckets": [
		{
			"binding": "SPLINE_ASSETS",
			"bucket_name": "spline-assets"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eleen-db",
			"database_id": "6a11307f-335d-4269-b615-94912feaea85"
		}
	],
	"upload_source_maps": true,
	// Clerk Auth - Add your keys from https://dashboard.clerk.com
	// For local dev, set these in a .dev.vars file (never commit secrets!)
	// For production, set via: wrangler secret put CLERK_SECRET_KEY
	"vars": {
		"CLERK_PUBLISHABLE_KEY": "pk_test_ZmVhc2libGUtZmFsY29uLTkzLmNsZXJrLmFjY291bnRzLmRldiQ"
	}
}