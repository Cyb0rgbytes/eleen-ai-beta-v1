/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eleen-ai-beta-v1",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		// Built by `npm run build` (vite.config.ts) from web/. Never commit dist/.
		"directory": "./dist",
		// The Asset Worker normally runs BEFORE the User Worker, so "/" would be
		// served straight from dist/index.html and our fetch handler would never
		// see it. We need it to, in order to attach RFC 8288 Link headers and do
		// Accept: text/markdown negotiation. env.ASSETS.fetch() bypasses this
		// setting, so delegating back to it (see src/index.ts) does not loop.
		// These paths match a static asset; every other route already falls
		// through to the Worker on its own. The privacy page is listed so it
		// gets the security headers (CSP, frame-ancestors, HSTS) like "/" does.
		"run_worker_first": [
			"/",
			"/index.html",
			"/privacy",
			"/privacy.html"
		]
	},
	// Import *.md as strings so agent-facing renditions (home, docs, auth, skills)
	// are compiled into the bundle. The alternative — fetching them at runtime —
	// is impossible here: global_fetch_strictly_public forbids the Worker from
	// fetching its own hostname.
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.md"
			],
			"fallthrough": true
		}
	],
	// Build the frontend and regenerate the skill digest manifest on dev,
	// deploy and dry-run. Doing it here rather than only in a package.json
	// hook means a `wrangler deploy` typed directly, or a CI provider running
	// its own command, still ships current digests and a current dist/.
	"build": {
		"command": "npm run build",
		"watch_dir": ["./src", "./web"]
	},
	"observability": {
		"enabled": true
	},
	// Daily at 03:17 UTC: purge conversations deleted more than 30 days ago
	// (the scheduled handler in src/index.ts).
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	// Models always run on Cloudflare, so local dev calls (and is billed for)
	// real inference. Stated explicitly rather than left as a warning.
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"kv_namespaces": [
		{
			"binding": "ELEEN_MEMORY",
			"id": "66feaec842224318820adb53c0c99492"
		}
	],
	// `npm run dev` runs locally, so this binding uses a local SQLite copy and
	// never the production database. Do not reintroduce `wrangler dev --remote`
	// without a preview_database_id: in remote mode, a binding with no preview
	// ID connects to database_id, which is production.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eleen-db",
			"database_id": "6a11307f-335d-4269-b615-94912feaea85",
			"migrations_dir": "migrations"
		}
	],
	// Burst guard: 15 requests per 10 seconds per caller, across every API
	// bucket. The hourly quotas live in D1 (src/lib/ratelimit.ts).
	"ratelimits": [
		{
			"name": "BURST",
			"namespace_id": "1001",
			"simple": {
				"limit": 15,
				"period": 10
			}
		}
	],
	"r2_buckets": [
		{
			"binding": "SPLINE_ASSETS",
			"bucket_name": "spline-assets"
		},
		// M5.2: files users attach to chats. Private (no public URL, no
		// custom domain): bytes are only ever read back by the Worker, under
		// u/{userId}/ (src/files/store.ts).
		{
			"binding": "UPLOADS",
			"bucket_name": "eleen-uploads"
		}
	],
	"upload_source_maps": true,
	// Clerk Auth - Add your keys from https://dashboard.clerk.com
	// For local dev, set these in a .dev.vars file (never commit secrets!)
	// For production, set via: wrangler secret put CLERK_SECRET_KEY
	"vars": {
		"CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZWxlZW5haS54eXok",
		// Workers AI calls are routed through this gateway (src/ai/gateway.ts).
		// It must hold no provider keys: the gateway falls back to a stored key
		// when a request carries none, which would bill the owner silently.
		"AI_GATEWAY_ID": "eleenai-gateway",
		// "enforce" (the default) or "report": the way back to a Report-Only
		// CSP if enforcement ever breaks the page (src/lib/security-headers.ts).
		"CSP_MODE": "enforce"
	}
}