/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eleen-ai-beta-v1",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "ELEEN_MEMORY",
			"id": "placeholder_for_kv_id_will_be_auto_created" // This is fine for dev/local, wrangler prompts to create it or handles it. Actually, for wrangler deploy to work, you need a real ID, but we'll leave it as a placeholder and let wrangler guide the user or assume it'll be updated. Wait, for dev it works without an ID, or we can use preview_id.
		}
	],
	"upload_source_maps": true,
	// Clerk Auth - Add your keys from https://dashboard.clerk.com
	// For local dev, set these in a .dev.vars file (never commit secrets!)
	// For production, set via: wrangler secret put CLERK_SECRET_KEY
	"vars": {
		"CLERK_PUBLISHABLE_KEY": "pk_test_cGxlYXNpbmctbW9sbHktODYuY2xlcmsuYWNjb3VudHMuZGV2JA"
	}
}