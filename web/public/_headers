# Static assets are answered by the asset server before the Worker runs, so
# they never pass through src/lib/security-headers.ts (final audit #12).
# HTML pages, the service worker, the manifest and the offline page are
# routed through the Worker (wrangler.jsonc run_worker_first) and get the
# full set there.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed by Vite: a changed file gets a new name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
