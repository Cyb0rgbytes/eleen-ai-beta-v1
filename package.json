{
	"name": "eleen-ai-beta-v1",
	"description": "A simple chat application powered by Cloudflare Workers AI",
	"cloudflare": {
		"label": "LLM Chat App",
		"products": [
			"Workers",
			"Workers AI",
			"AI Gateway"
		],
		"categories": [
			"ai"
		],
		"docs_url": "https://developers.cloudflare.com/workers-ai/",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/a974bd55-20c6-4656-fa29-1551d43ddc00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/65dd8441-89d3-491d-c5a1-0a000d070700/preview",
		"publish": true
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.2",
		"@phosphor-icons/core": "2.1.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "24.10.1",
		"@types/prismjs": "1.26.5",
		"happy-dom": "21.0.3",
		"typescript": "5.9.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.151.0"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"skills": "node scripts/gen-skill-digests.mjs",
		"build": "node scripts/gen-skill-digests.mjs && vite build",
		"check": "node scripts/gen-skill-digests.mjs --check && node scripts/gen-icons.mjs --check && tsc --noEmit && tsc -p web/tsconfig.json && wrangler deploy --dry-run && node scripts/check-bundle-size.mjs",
		"deploy": "node scripts/deploy.mjs",
		"verify-deploy": "node scripts/verify-deploy.mjs",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"e2e": "playwright test",
		"db:migrate:local": "wrangler d1 migrations apply eleen-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply eleen-db --remote"
	},
	"dependencies": {
		"@clerk/backend": "^2.33.7",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/noto-sans-arabic": "5.3.0",
		"marked": "18.1.1",
		"motion": "14.3.0",
		"prismjs": "1.30.0"
	}
}
