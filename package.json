{
	"name": "eleen-ai-beta-v1",
	"description": "A simple chat application powered by Cloudflare Workers AI",
	"cloudflare": {
		"label": "LLM Chat App",
		"products": [
			"Workers",
			"Workers AI",
			"AI Gateway"
		],
		"categories": [
			"ai"
		],
		"docs_url": "https://developers.cloudflare.com/workers-ai/",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/a974bd55-20c6-4656-fa29-1551d43ddc00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/65dd8441-89d3-491d-c5a1-0a000d070700/preview",
		"publish": true
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.2",
		"@types/node": "24.10.1",
		"typescript": "5.9.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.151.0"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"skills": "node scripts/gen-skill-digests.mjs",
		"check": "node scripts/gen-skill-digests.mjs --check && tsc --noEmit && wrangler deploy --dry-run",
		"predeploy": "node scripts/gen-skill-digests.mjs",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply eleen-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply eleen-db --remote"
	},
	"dependencies": {
		"@clerk/backend": "^2.33.7"
	}
}
